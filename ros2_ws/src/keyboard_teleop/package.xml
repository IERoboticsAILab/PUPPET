<?xml version="1.0"?>
<package format="3">
  <name>keyboard_teleop</name>
  <version>2.0.0</version>
  <description>Keyboard arm teleoperation for TIAGo (the study's keyboard condition), ROS 2. Drives the same arm_tp_controller as the headset; no MoveIt.</description>
  <maintainer email="123842829+rorosaga@users.noreply.github.com">Rodrigo Sagastegui</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>tiago_telepresence_controllers</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
